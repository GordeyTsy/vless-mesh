#!/usr/bin/env bash
set -euo pipefail

# VLESS Reality (PQ-capable) + Tinc hub server
# Usage: setup-server --mesh-ip 10.10.0.1 --pub-addr 1.2.3.4 [--vless-port 443] [--tinc-port 6060] [--mtu 1400]

usage() {
cat <<'EOF'
setup-server --mesh-ip IP --pub-addr ADDR [options]
  --mesh-ip IP         Mesh /24 address of server (required)
  --pub-addr ADDR      Public IP/DNS clients reach (required)
  --vless-port PORT    VLESS listen port (default 443)
  --tinc-port PORT     Tinc TCP port (default 6060)
  --mtu MTU            MTU for mesh0 (default 1400)
  --reality-dest H:P   Fake SNI/DEST for Reality (default www.microsoft.com:443)
  --mesh-uuid UUID     Shared mesh UUID (default generate)
  --registry-port PORT Registry HTTP port (default 9000)
  --registry-token TOK Pre-shared token (default generate)
  -h                   help
EOF
}

need_root(){ [ "$(id -u)" = 0 ] || { echo "Run as root"; exit 1; }; }

MESH_IP=""; PUB_ADDR=""; VLESS_PORT=443; TINC_PORT=6060; MTU=1400; UUID=""; REALITY_DEST="www.microsoft.com:443"; MESH_UUID=""; REG_PORT=9000; REG_TOKEN=""
while [[ $# -gt 0 ]]; do
  case "$1" in
    --mesh-ip) MESH_IP="$2"; shift 2;;
    --pub-addr) PUB_ADDR="$2"; shift 2;;
    --vless-port) VLESS_PORT="$2"; shift 2;;
    --tinc-port) TINC_PORT="$2"; shift 2;;
    --mtu) MTU="$2"; shift 2;;
    --reality-dest) REALITY_DEST="$2"; shift 2;;
    --mesh-uuid) MESH_UUID="$2"; shift 2;;
    --registry-port) REG_PORT="$2"; shift 2;;
    --registry-token) REG_TOKEN="$2"; shift 2;;
    --uuid) UUID="$2"; shift 2;;
    -h|--help) usage; exit 0;;
    *) echo "Unknown $1"; usage; exit 1;;
  esac
done
[[ -n "$MESH_IP" && -n "$PUB_ADDR" ]] || { usage; exit 1; }
UUID=${UUID:-$(uuidgen)}
MESH_UUID=${MESH_UUID:-$(uuidgen)}
REG_TOKEN=${REG_TOKEN:-$(openssl rand -hex 16)}

need_root
apt-get update -qq
apt-get install -yq tinc curl jq python3-cryptography python3 iperf3 >/dev/null
command -v xray >/dev/null || bash <(curl -fsSL https://github.com/XTLS/Xray-install/raw/main/install-release.sh) >/tmp/xray-install.log 2>&1

# Reality keypair (X25519) for server; shortId 8 hex chars
# reality key generation (supports both "Private key" and "PrivateKey" outputs)
REALITY_KEYPAIR=$(xray x25519 || true)
REALITY_PRIV=$(printf "%s\n" "$REALITY_KEYPAIR" | awk '/Private key|PrivateKey/{print $3}')
REALITY_PUB=$(printf "%s\n" "$REALITY_KEYPAIR" | awk '/Public key|PublicKey/{print $3}')

if [[ -z "$REALITY_PRIV" || -z "$REALITY_PUB" ]]; then
  # Fallback: generate X25519 with python to ensure Reality keys exist
  PY_KEYS=$(python3 - <<'PY'
import base64
from cryptography.hazmat.primitives.asymmetric.x25519 import X25519PrivateKey
from cryptography.hazmat.primitives import serialization

priv = X25519PrivateKey.generate()
pub = priv.public_key()
enc = lambda b: base64.urlsafe_b64encode(b).rstrip(b'=').decode()

print(enc(priv.private_bytes(
    encoding=serialization.Encoding.Raw,
    format=serialization.PrivateFormat.Raw,
    encryption_algorithm=serialization.NoEncryption()
)))

print(enc(pub.public_bytes(
    encoding=serialization.Encoding.Raw,
    format=serialization.PublicFormat.Raw
)))
PY
  )
  REALITY_PRIV=$(printf "%s" "$PY_KEYS" | sed -n '1p')
  REALITY_PUB=$(printf "%s" "$PY_KEYS" | sed -n '2p')
fi

SHORT_ID=$(openssl rand -hex 4)
DEST_HOST=${REALITY_DEST%%:*}

BASE=/etc/tinc/mesh
rm -rf "$BASE"
mkdir -p "$BASE/hosts"

cat >"$BASE/tinc.conf" <<EOF
Name = server
Interface = mesh0
Mode = switch
Device = /dev/net/tun
Port = $TINC_PORT
TCPOnly = yes
EOF

cat >"$BASE/tinc-up" <<EOF
#!/bin/sh
IF=mesh0
ip link set \$IF up
ip addr add $MESH_IP/24 dev \$IF
ip link set dev \$IF mtu $MTU
EOF
cat >"$BASE/tinc-down" <<EOF
#!/bin/sh
IF=mesh0
ip addr del $MESH_IP/24 dev \$IF 2>/dev/null || true
ip link set \$IF down || true
EOF
chmod +x "$BASE/tinc-up" "$BASE/tinc-down"

rm -f "$BASE/rsa_key.priv"
tincd -n mesh -K4096 <<EOF
y
EOF
PUBK=$(awk 'BEGIN{p=0} /^-----BEGIN RSA PUBLIC KEY-----/{p=1} /^-----END/{print;exit} {if(p)print}' "$BASE/hosts/server")
cat >"$BASE/hosts/server" <<EOF
Subnet = $MESH_IP/32
Address = 127.0.0.1
Port = $TINC_PORT
$PUBK
EOF

# Xray: inbound VLESS Reality (PQ-capable), outbound freedom redirect to local tinc
cat >/usr/local/etc/xray/config.json <<EOF
{
  "log":{"loglevel":"warning"},
  "inbounds":[
    {
      "tag":"vless-in",
      "listen":"0.0.0.0",
      "port":$VLESS_PORT,
      "protocol":"vless",
      "settings":{
        "clients":[{"id":"$MESH_UUID","level":0}],
        "decryption":"none"
      },
      "streamSettings":{
        "network":"tcp",
        "security":"reality",
        "realitySettings":{
          "show":false,
          "dest":"$REALITY_DEST",
          "serverNames":["$DEST_HOST"],
          "privateKey":"$REALITY_PRIV",
          "shortIds":["$SHORT_ID"],
          "fingerprint":"chrome"
        }
      }
    }
  ],
  "outbounds":[
    {
      "tag":"to-tinc",
      "protocol":"freedom",
      "settings":{"redirect":"127.0.0.1:$TINC_PORT"}
    }
  ],
  "routing":{"rules":[{"type":"field","inboundTag":["vless-in"],"outboundTag":"to-tinc"}]}
}
EOF

echo mesh >/etc/tinc/nets.boot
systemctl enable --now tinc@mesh
systemctl enable --now xray

# iperf3 server for throughput probing (P2P selection)
cat >/etc/systemd/system/iperf3-mesh.service <<'EOF'
[Unit]
Description=iperf3 server for mesh
After=network.target

[Service]
User=nobody
ExecStart=/usr/bin/iperf3 -s -p 5201
Restart=on-failure

[Install]
WantedBy=multi-user.target
EOF
systemctl daemon-reload
systemctl enable --now iperf3-mesh.service

# Mesh registry data
mkdir -p /etc/vless-mesh
echo "$REG_TOKEN" >/etc/vless-mesh/token
chmod 600 /etc/vless-mesh/token

HOST_B64=$(base64 -w0 "$BASE/hosts/server")
cat >/etc/vless-mesh/peers.json <<EOF
{
  "uuid": "$MESH_UUID",
  "peers": [
    {
      "name": "server",
      "mesh_ip": "$MESH_IP",
      "pub_addr": "$PUB_ADDR",
      "vless_port": $VLESS_PORT,
      "reality_pub": "$REALITY_PUB",
      "short_id": "$SHORT_ID",
      "sni": "$DEST_HOST",
      "tinc_port": $TINC_PORT,
      "fw_base": 7000,
      "host_b64": "$HOST_B64",
      "updated": $(date +%s)
    }
  ]
}
EOF

cat >/usr/local/sbin/mesh-registry.py <<'PY'
#!/usr/bin/env python3
import json, base64, os, sys, time
from http.server import BaseHTTPRequestHandler, HTTPServer
from pathlib import Path

DATA = Path(sys.argv[1]) if len(sys.argv)>1 else Path('/etc/vless-mesh/peers.json')
TOKEN_FILE = Path('/etc/vless-mesh/token')
HOSTS_DIR = Path('/etc/tinc/mesh/hosts')

def load_token():
    try:
        return TOKEN_FILE.read_text().strip()
    except Exception:
        return ''

def load_peers():
    if DATA.exists():
        return json.loads(DATA.read_text())
    return {"uuid": None, "peers": []}

def save_peers(data):
    tmp = DATA.with_suffix('.tmp')
    tmp.write_text(json.dumps(data, indent=2))
    tmp.replace(DATA)

class Handler(BaseHTTPRequestHandler):
    def _auth(self):
        token = self.headers.get('X-Mesh-Token','')
        return token == load_token()
    def _json(self, code, obj):
        body = json.dumps(obj).encode()
        self.send_response(code)
        self.send_header('Content-Type','application/json')
        self.send_header('Content-Length', str(len(body)))
        self.end_headers(); self.wfile.write(body)
    def do_GET(self):
        if self.path != '/peers':
            self.send_response(404); self.end_headers(); return
        if not self._auth():
            self.send_response(401); self.end_headers(); return
        data = load_peers()
        self._json(200, data)
    def do_POST(self):
        if self.path != '/register':
            self.send_response(404); self.end_headers(); return
        if not self._auth():
            self.send_response(401); self.end_headers(); return
        length = int(self.headers.get('Content-Length','0'))
        try:
            payload = json.loads(self.rfile.read(length))
        except Exception:
            self._json(400,{"error":"bad json"}); return
        required = ["name","mesh_ip","pub_addr","vless_port","reality_pub","short_id","sni","tinc_port","fw_base","uuid","host_b64","accept"]
        if any(k not in payload for k in required):
            self._json(400,{"error":"missing fields"}); return
        data = load_peers()
        if data.get('uuid') and data['uuid'] != payload['uuid']:
            self._json(400,{"error":"uuid mismatch"}); return
        if not data.get('uuid'):
            data['uuid'] = payload['uuid']
        payload['updated'] = int(time.time())
        # store host file
        try:
            raw = base64.b64decode(payload['host_b64'])
            HOSTS_DIR.mkdir(parents=True, exist_ok=True)
            (HOSTS_DIR / payload['name']).write_bytes(raw)
        except Exception:
            self._json(400,{"error":"bad host_b64"}); return
        peers = [p for p in data['peers'] if p.get('name') != payload['name']]
        peers.append({k:payload[k] for k in payload})
        data['peers'] = peers
        save_peers(data)
        self._json(200, data)

def run():
    port = int(os.environ.get('REGISTRY_PORT','9000'))
    httpd = HTTPServer(('0.0.0.0', port), Handler)
    httpd.serve_forever()

if __name__ == '__main__':
    run()
PY
chmod +x /usr/local/sbin/mesh-registry.py

cat >/etc/systemd/system/mesh-registry.service <<EOF
[Unit]
Description=Mesh registry API
After=network.target

[Service]
Environment=REGISTRY_PORT=$REG_PORT
ExecStart=/usr/local/sbin/mesh-registry.py /etc/vless-mesh/peers.json
Restart=on-failure
User=root

[Install]
WantedBy=multi-user.target
EOF

systemctl daemon-reload
systemctl enable --now mesh-registry.service

cat <<EOF
Server ready.
  Public VLESS: $PUB_ADDR:$VLESS_PORT
  VLESS UUID (mesh): $MESH_UUID
  Reality public key: $REALITY_PUB
  Reality shortId: $SHORT_ID
  Reality dest / SNI: $REALITY_DEST (serverName=$DEST_HOST)
  Mesh UUID: $MESH_UUID
  Registry: http://$PUB_ADDR:$REG_PORT (token in /etc/vless-mesh/token)
  Tinc host file: /etc/tinc/mesh/hosts/server
Distribute the host file, mesh UUID, registry token to clients.
EOF
