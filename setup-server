    if DATA.exists():
        return json.loads(DATA.read_text())
    return {"uuid": None, "peers": []}

def save_peers(data):
    tmp = DATA.with_suffix('.tmp')
    tmp.write_text(json.dumps(data, indent=2))
    tmp.replace(DATA)

class Handler(BaseHTTPRequestHandler):
    def _auth(self):
        token = self.headers.get('X-Mesh-Token','')
        return token == load_token()
    def _json(self, code, obj):
        body = json.dumps(obj).encode()
        self.send_response(code)
        self.send_header('Content-Type','application/json')
        self.send_header('Content-Length', str(len(body)))
        self.end_headers(); self.wfile.write(body)
    def do_GET(self):
        if self.path != '/peers':
            self.send_response(404); self.end_headers(); return
        if not self._auth():
            self.send_response(401); self.end_headers(); return
        data = load_peers()
        self._json(200, data)
    def do_POST(self):
        if self.path != '/register':
            self.send_response(404); self.end_headers(); return
        if not self._auth():
            self.send_response(401); self.end_headers(); return
        length = int(self.headers.get('Content-Length','0'))
        try:
            payload = json.loads(self.rfile.read(length))
        except Exception:
            self._json(400,{"error":"bad json"}); return
        required = ["name","mesh_ip","pub_addr","vless_port","reality_pub","short_id","sni","tinc_port","fw_base","uuid","host_b64","accept"]
        if any(k not in payload for k in required):
            self._json(400,{"error":"missing fields"}); return
        data = load_peers()
        if data.get('uuid') and data['uuid'] != payload['uuid']:
            self._json(400,{"error":"uuid mismatch"}); return
        if not data.get('uuid'):
            data['uuid'] = payload['uuid']
        payload['updated'] = int(time.time())
        try:
            raw = base64.b64decode(payload['host_b64'])
            HOSTS_DIR.mkdir(parents=True, exist_ok=True)
            (HOSTS_DIR / payload['name']).write_bytes(raw)
        except Exception:
            self._json(400,{"error":"bad host_b64"}); return
        peers = [p for p in data['peers'] if p.get('name') != payload['name']]
        peers.append({k:payload[k] for k in payload})
        data['peers'] = peers
        save_peers(data)
        self._json(200, data)

def run():
    port = int(os.environ.get('REGISTRY_PORT','9000'))
    httpd = HTTPServer(('0.0.0.0', port), Handler)
    httpd.serve_forever()

if __name__ == '__main__':
    run()
