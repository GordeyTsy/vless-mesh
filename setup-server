MESH_IP=""; PUB_ADDR=""; VLESS_PORT=443; TINC_PORT=6060; MTU=1400; UUID=""; REALITY_DEST="www.microsoft.com:443"; MESH_UUID=""; REG_PORT=9000; REG_TOKEN=""
DEPLOY="host"; IMAGE_REGISTRY=""
HOST_NODE=$(hostname -s)
while [[ $# -gt 0 ]]; do
