        - name: mesh
          image: $IMAGE_TAG
          securityContext:
            privileged: true
            capabilities:
              add: ["NET_ADMIN"]
          env:
            - name: MODE
              value: "server"
            - name: ENABLE_REGISTRY
              value: "1"
            - name: ENABLE_IPERF
              value: "1"
            - name: REGISTRY_PORT
              value: "$REG_PORT"
          volumeMounts:
            - name: tinc
              mountPath: /etc/tinc/mesh
            - name: xray
              mountPath: /usr/local/etc/xray
            - name: vless
              mountPath: /etc/vless-mesh
      volumes:
        - name: tinc
          hostPath:
            path: /etc/tinc/mesh
