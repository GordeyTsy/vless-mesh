            path: /usr/local/etc/xray
        - name: vless
          hostPath:
            path: /etc/vless-mesh
EOF
  echo "$file"
}

apply_k8s_clients() {
  local ns="vless-mesh"
  local image="$IMAGE_TAG"
  local server_addr="$PUB_ADDR"
  if [[ -n "${LAN_IP:-}" && "${LAN_IP}" != "${PUB_ADDR}" ]]; then
    server_addr="${LAN_IP},${PUB_ADDR}"
  fi

  k create ns "$ns" --dry-run=client -o yaml | k apply -f -

  k -n "$ns" create secret generic mesh-client-secret \
    --from-literal=server_addr="$server_addr" \
    --from-literal=token="$REG_TOKEN" \
    --from-literal=mesh_uuid="$MESH_UUID" \
    --dry-run=client -o yaml | k apply -f -

  k -n "$ns" create configmap mesh-client-config \
    --from-literal=vless_port="$VLESS_PORT" \
    --from-literal=tinc_port="$TINC_PORT" \
    --from-literal=fw_base="17000" \
    --from-literal=reg_port="$REG_PORT" \
    --from-literal=reality_dest="$REALITY_DEST" \
    --from-literal=dial_only="0" \
    --from-literal=relay_server="1" \
    --from-literal=relay_port="4443" \
    --dry-run=client -o yaml | k apply -f -

  cat <<EOF | k apply -f -
apiVersion: apps/v1
kind: DaemonSet
metadata:
  name: mesh-client
  namespace: ${ns}
  labels:
    app: vless-mesh-client
spec:
  selector:
    matchLabels:
      app: vless-mesh-client
  template:
    metadata:
      labels:
        app: vless-mesh-client
    spec:
      hostNetwork: true
      dnsPolicy: ClusterFirstWithHostNet
      tolerations:
        - key: "node.kubernetes.io/not-ready"
          operator: "Exists"
          effect: "NoExecute"
        - key: "node.kubernetes.io/unreachable"
          operator: "Exists"
          effect: "NoExecute"
        - key: "node.kubernetes.io/not-ready"
          operator: "Exists"
          effect: "NoSchedule"
        - key: "node.kubernetes.io/unreachable"
          operator: "Exists"
          effect: "NoSchedule"
      affinity:
        nodeAffinity:
          requiredDuringSchedulingIgnoredDuringExecution:
            nodeSelectorTerms:
              - matchExpressions:
                  - key: node-role.kubernetes.io/control-plane
                    operator: DoesNotExist
                  - key: node-role.kubernetes.io/master
                    operator: DoesNotExist
      containers:
        - name: mesh-client
          image: ${image}
          imagePullPolicy: IfNotPresent
          securityContext:
            privileged: true
            capabilities:
              add: ["NET_ADMIN","NET_RAW"]
          env:
            - name: MODE
              value: "client"
            - name: NAME
              valueFrom:
                fieldRef:
                  fieldPath: spec.nodeName
            - name: NODE_IP
              valueFrom:
                fieldRef:
                  fieldPath: status.hostIP
            - name: SERVER_ADDR
              valueFrom:
                secretKeyRef:
                  name: mesh-client-secret
                  key: server_addr
            - name: MESH_TOKEN
              valueFrom:
                secretKeyRef:
                  name: mesh-client-secret
                  key: token
            - name: MESH_UUID
              valueFrom:
                secretKeyRef:
                  name: mesh-client-secret
                  key: mesh_uuid
            - name: VLESS_PORT
              valueFrom:
                configMapKeyRef:
                  name: mesh-client-config
                  key: vless_port
            - name: TINC_PORT
              valueFrom:
                configMapKeyRef:
                  name: mesh-client-config
                  key: tinc_port
            - name: FW_BASE
              valueFrom:
                configMapKeyRef:
                  name: mesh-client-config
                  key: fw_base
            - name: REG_PORT
              valueFrom:
                configMapKeyRef:
                  name: mesh-client-config
                  key: reg_port
            - name: REALITY_DEST
              valueFrom:
                configMapKeyRef:
                  name: mesh-client-config
                  key: reality_dest
            - name: MESH_DIAL_ONLY
              valueFrom:
                configMapKeyRef:
                  name: mesh-client-config
                  key: dial_only
            - name: RELAY_SERVER
              valueFrom:
                configMapKeyRef:
                  name: mesh-client-config
                  key: relay_server
            - name: RELAY_PORT
              valueFrom:
                configMapKeyRef:
                  name: mesh-client-config
                  key: relay_port
          volumeMounts:
            - name: tinc-etc
              mountPath: /etc/tinc/mesh
            - name: xray-etc
              mountPath: /usr/local/etc/xray
            - name: vless-etc
              mountPath: /etc/vless-mesh
            - name: dev-net-tun
              mountPath: /dev/net/tun
          resources:
            requests:
              cpu: 50m
              memory: 128Mi
      volumes:
        - name: tinc-etc
          hostPath:
            path: /etc/tinc/mesh
            type: DirectoryOrCreate
        - name: xray-etc
          hostPath:
            path: /usr/local/etc/xray
            type: DirectoryOrCreate
        - name: vless-etc
          hostPath:
            path: /etc/vless-mesh
            type: DirectoryOrCreate
        - name: dev-net-tun
          hostPath:
            path: /dev/net/tun
            type: CharDevice
EOF
}
MESH_IP=""; PUB_ADDR=""; VLESS_PORT=443; TINC_PORT=6060; MTU=1400; UUID=""; REALITY_DEST="www.microsoft.com:443"; MESH_UUID=""; REG_PORT=9000; REG_TOKEN=""
DEPLOY="host"; IMAGE_REGISTRY=""
KUBELET_NODE_IP=1
INSTALL_K8S_CLIENTS=1; INSTALL_K8S_CLIENTS_SET=0
HOST_NODE=$(hostname -s)
while [[ $# -gt 0 ]]; do
  case "$1" in
    --mesh-ip) MESH_IP="$2"; shift 2;;
    --pub-addr) PUB_ADDR="$2"; shift 2;;
    --vless-port) VLESS_PORT="$2"; shift 2;;
    --tinc-port) TINC_PORT="$2"; shift 2;;
    --mtu) MTU="$2"; shift 2;;
    --reality-dest) REALITY_DEST="$2"; shift 2;;
    --mesh-uuid) MESH_UUID="$2"; shift 2;;
    --registry-port) REG_PORT="$2"; shift 2;;
    --registry-token) REG_TOKEN="$2"; shift 2;;
    --uuid) UUID="$2"; shift 2;;
    --deploy) DEPLOY="$2"; shift 2;;
    --image-registry) IMAGE_REGISTRY="$2"; shift 2;;
    --no-kubelet-node-ip) KUBELET_NODE_IP=0; shift 1;;
    --k8s-clients) INSTALL_K8S_CLIENTS=1; INSTALL_K8S_CLIENTS_SET=1; shift 1;;
    --no-k8s-clients) INSTALL_K8S_CLIENTS=0; INSTALL_K8S_CLIENTS_SET=1; shift 1;;
    -h|--help) usage; exit 0;;
    *) echo "Unknown $1"; usage; exit 1;;
  esac
done
UUID=${UUID:-$(uuidgen)}
if [[ "$DEPLOY" != "container" ]]; then
  MESH_UUID=${MESH_UUID:-$(uuidgen)}
  REG_TOKEN=${REG_TOKEN:-$(openssl rand -hex 16)}
fi
case "$DEPLOY" in
  host|compose|k8s|container) ;;
  *) echo "Unsupported --deploy $DEPLOY (expected host|compose|k8s|container)"; exit 1;;
esac
if [[ -n "$IMAGE_REGISTRY" && "$IMAGE_REGISTRY" != */ ]]; then
  IMAGE_REGISTRY="$IMAGE_REGISTRY/"
fi
IMAGE_TAG="${IMAGE_REGISTRY}vless-mesh-node:latest"

need_root
IPTABLES_BIN="$(detect_iptables_bin || true)"
LAN_IP="$(detect_host_ip || true)"
LAN_IP="${LAN_IP:-$(hostname -I | awk '{print $1}')}"
if [[ -z "${MESH_IP}" || "${MESH_IP}" == "auto" ]]; then
  MESH_IP="$(auto_mesh_ip "${LAN_IP:-}")"
fi
if [[ -z "${MESH_IP}" ]]; then
  echo "Unable to derive --mesh-ip automatically; please pass --mesh-ip explicitly." >&2
  exit 1
fi
[[ -n "$PUB_ADDR" ]] || { usage; exit 1; }

MESH_PREFIX="${MESH_IP%.*}"
MESH_CIDR="${MESH_PREFIX}.0/24"
ensure_mesh_egress_nat "$MESH_CIDR"

if [[ "$DEPLOY" == "host" ]]; then
  apt-get update -qq
  apt-get install -yq tinc curl jq python3-cryptography python3 iperf3 >/dev/null
  command -v xray >/dev/null || bash <(curl -fsSL https://github.com/XTLS/Xray-install/raw/main/install-release.sh) >/tmp/xray-install.log 2>&1
fi

# For container deployments, preserve stable identity across restarts by persisting it in /etc/vless-mesh/server.json.
SERVER_STATE=/etc/vless-mesh/server.json
mkdir -p /etc/vless-mesh
if [[ "$DEPLOY" == "container" ]]; then
  if [[ -f /etc/vless-mesh/token ]]; then
    REG_TOKEN="$(cat /etc/vless-mesh/token | tr -d '\n' || true)"
  fi
  if [[ -f /etc/vless-mesh/peers.json ]]; then
    MESH_UUID="$(python3 -c 'import json; print(json.load(open("/etc/vless-mesh/peers.json")).get("uuid",""))' 2>/dev/null || true)"
  fi
  if [[ -f "${SERVER_STATE}" ]]; then
    REALITY_PRIV="$(python3 -c 'import json; print(json.load(open("/etc/vless-mesh/server.json")).get("reality_priv",""))' 2>/dev/null || true)"
    REALITY_PUB="$(python3 -c 'import json; print(json.load(open("/etc/vless-mesh/server.json")).get("reality_pub",""))' 2>/dev/null || true)"
    SHORT_ID="$(python3 -c 'import json; print(json.load(open("/etc/vless-mesh/server.json")).get("short_id",""))' 2>/dev/null || true)"
    if [[ -z "${MESH_UUID}" ]]; then
      MESH_UUID="$(python3 -c 'import json; print(json.load(open("/etc/vless-mesh/server.json")).get("mesh_uuid",""))' 2>/dev/null || true)"
    fi
  fi

  MESH_UUID=${MESH_UUID:-$(uuidgen)}
  REG_TOKEN=${REG_TOKEN:-$(openssl rand -hex 16)}
fi

# Reality keypair (X25519) for server; shortId 8 hex chars
# reality key generation (supports both "Private key" and "PrivateKey" outputs)
REALITY_KEYPAIR=$(xray x25519 || true)
REALITY_PRIV=${REALITY_PRIV:-$(printf "%s\n" "$REALITY_KEYPAIR" | awk '/Private key|PrivateKey/{print $3}')}
REALITY_PUB=${REALITY_PUB:-$(printf "%s\n" "$REALITY_KEYPAIR" | awk '/Public key|PublicKey/{print $3}')}

if [[ -z "$REALITY_PRIV" || -z "$REALITY_PUB" ]]; then
  # Fallback: generate X25519 with python to ensure Reality keys exist
  PY_KEYS=$(python3 - <<'PY'
import base64
from cryptography.hazmat.primitives.asymmetric.x25519 import X25519PrivateKey
from cryptography.hazmat.primitives import serialization

priv = X25519PrivateKey.generate()
pub = priv.public_key()
enc = lambda b: base64.urlsafe_b64encode(b).rstrip(b'=').decode()

print(enc(priv.private_bytes(
    encoding=serialization.Encoding.Raw,
    format=serialization.PrivateFormat.Raw,
    encryption_algorithm=serialization.NoEncryption()
)))

print(enc(pub.public_bytes(
    encoding=serialization.Encoding.Raw,
    format=serialization.PublicFormat.Raw
)))
PY
