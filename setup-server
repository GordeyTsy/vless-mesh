#!/usr/bin/env bash
set -euo pipefail

# VLESS Reality (PQ-capable) + Tinc hub server
# Usage: setup-server --mesh-ip 10.10.0.1 --pub-addr 1.2.3.4 [--vless-port 443] [--tinc-port 6060] [--mtu 1400]
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

usage() {
cat <<'EOF'
setup-server --mesh-ip IP --pub-addr ADDR [options]
  --mesh-ip IP         Mesh /24 address of server (default auto from host IP; supports "auto")
  --pub-addr ADDR      Public IP/DNS clients reach (required)
  --vless-port PORT    VLESS listen port (default 443)
  --tinc-port PORT     Tinc TCP port (default 6060)
  --mtu MTU            MTU for mesh0 (default 1400)
  --reality-dest H:P   Fake SNI/DEST for Reality (default www.microsoft.com:443)
  --mesh-uuid UUID     Shared mesh UUID (default generate)
  --registry-port PORT Registry HTTP port (default 9000)
  --registry-token TOK Pre-shared token (default generate)
  --deploy MODE        host|compose|k8s|container (default host)
  --image-registry R/  Registry prefix for container image (e.g. registry:443/) for compose/k8s
  --k8s-clients        Install mesh client DaemonSet (default auto if kubectl is present)
  --no-k8s-clients     Disable auto DaemonSet install
  --no-kubelet-node-ip Do not set kubelet --node-ip to mesh IP
  -h                   help
EOF
}

need_root(){ [ "$(id -u)" = 0 ] || { echo "Run as root"; exit 1; }; }

ensure_docker(){ command -v docker >/dev/null || { echo "docker is required for --deploy compose/k8s"; exit 1; }; }
ensure_kubectl(){ command -v kubectl >/dev/null || { echo "kubectl is required for --deploy k8s"; exit 1; }; }

k(){ env -u HTTPS_PROXY -u https_proxy -u HTTP_PROXY -u http_proxy -u ALL_PROXY -u all_proxy kubectl "$@"; }

detect_host_ip() {
  ip route get 1.1.1.1 2>/dev/null | awk '{for(i=1;i<=NF;i++) if($i=="src"){print $(i+1); exit}}'
}

detect_default_iface() {
  ip route get 1.1.1.1 2>/dev/null | awk '{for(i=1;i<=NF;i++) if($i=="dev"){print $(i+1); exit}}'
}

detect_iptables_bin() {
  local out=""
  if command -v iptables >/dev/null 2>&1; then
    out="$(iptables -t nat -S 2>&1 || true)"
    if echo "$out" | grep -q "iptables-legacy tables present"; then
      if command -v iptables-legacy >/dev/null 2>&1; then
        echo "iptables-legacy"
        return 0
      fi
    fi
    if [[ -n "$out" && ! "$out" =~ Incompatible\ with\ this\ kernel ]]; then
      echo "iptables"
      return 0
    fi
  fi
  if command -v iptables-legacy >/dev/null 2>&1; then
    echo "iptables-legacy"
    return 0
  fi
  return 1
}

set_kubelet_node_ip() {
  local mesh_ip="$1"
  local kubelet_file="/etc/default/kubelet"
  local tmp_file=""
  local updated=0

  if [[ -z "${mesh_ip}" ]]; then
    return 0
  fi
  if ! command -v systemctl >/dev/null 2>&1; then
    return 0
  fi
  if ! systemctl list-unit-files kubelet.service >/dev/null 2>&1; then
    return 0
  fi

  tmp_file="$(mktemp)"
  if [[ -f "${kubelet_file}" ]]; then
    while IFS= read -r line || [[ -n "${line}" ]]; do
      if [[ "${line}" == KUBELET_EXTRA_ARGS=* ]]; then
        local raw="${line#KUBELET_EXTRA_ARGS=}"
        raw="${raw%\"}"
        raw="${raw#\"}"
        raw="$(printf '%s' "${raw}" | sed -E 's/--node-ip=[^ ]+//g; s/[[:space:]]+/ /g; s/^ //; s/ $//')"
        if [[ -n "${raw}" ]]; then
          printf 'KUBELET_EXTRA_ARGS="%s --node-ip=%s"\n' "${raw}" "${mesh_ip}" >> "${tmp_file}"
        else
          printf 'KUBELET_EXTRA_ARGS=--node-ip=%s\n' "${mesh_ip}" >> "${tmp_file}"
        fi
        updated=1
      else
        printf '%s\n' "${line}" >> "${tmp_file}"
      fi
    done < "${kubelet_file}"
  fi
  if [[ "${updated}" -eq 0 ]]; then
    printf 'KUBELET_EXTRA_ARGS=--node-ip=%s\n' "${mesh_ip}" >> "${tmp_file}"
  fi
  mv "${tmp_file}" "${kubelet_file}"
  systemctl daemon-reload
  systemctl restart kubelet
}

auto_mesh_ip() {
  local src_ip="$1"
  local last_octet=""
  last_octet="$(printf '%s' "$src_ip" | awk -F. '{print $4}')"
  if [[ -n "$last_octet" && "$last_octet" =~ ^[0-9]+$ && "$last_octet" -ge 1 && "$last_octet" -le 254 ]]; then
    echo "10.10.0.${last_octet}"
  fi
}

ensure_mesh_egress_nat() {
  local mesh_cidr="$1"
  local iface="${2:-}"
  if [[ -z "${mesh_cidr}" ]]; then
    return 0
  fi
  if [[ -z "${IPTABLES_BIN:-}" ]]; then
    echo "mesh-nat: iptables missing; skipping" >&2
    return 0
  fi
  if [[ -z "${iface}" ]]; then
    iface="$(detect_default_iface || true)"
  fi
  if [[ -z "${iface}" ]]; then
    echo "mesh-nat: default interface not found; skipping" >&2
    return 0
  fi
  if command -v sysctl >/dev/null 2>&1; then
    sysctl -w net.ipv4.ip_forward=1 >/dev/null 2>&1 || true
  fi
  local chain="MESH_EGRESS"
  "$IPTABLES_BIN" -t nat -N "$chain" >/dev/null 2>&1 || true
  "$IPTABLES_BIN" -t nat -F "$chain" >/dev/null 2>&1 || true
  "$IPTABLES_BIN" -t nat -A "$chain" -s "$mesh_cidr" -o "$iface" -j MASQUERADE
  if ! "$IPTABLES_BIN" -t nat -C POSTROUTING -j "$chain" >/dev/null 2>&1; then
    "$IPTABLES_BIN" -t nat -A POSTROUTING -j "$chain"
  fi
}

write_docker_context() {
  local ctx="/etc/vless-mesh/docker-node"
  mkdir -p "$ctx"
  if [[ ! -f "$SCRIPT_DIR/setup-client" ]]; then
    echo "setup-client not found in $SCRIPT_DIR" >&2
    exit 1
  fi
  if [[ ! -f "$SCRIPT_DIR/docker-node/entry.sh" ]]; then
    echo "docker-node/entry.sh not found in $SCRIPT_DIR" >&2
    exit 1
  fi
  cp "$SCRIPT_DIR/setup-client" "$ctx/setup-client"
  cp "$SCRIPT_DIR/docker-node/entry.sh" "$ctx/entry.sh"
  chmod +x "$ctx/setup-client" "$ctx/entry.sh"
  cat >"$ctx/Dockerfile" <<'EOF'
FROM debian:12-slim
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
    tinc iproute2 python3 python3-cryptography jq curl iperf3 ca-certificates unzip openssl uuid-runtime procps ipset iptables \
    && mkdir -p /usr/local/share/xray /usr/local/etc/xray \
    && curl -L -o /tmp/xray.zip https://github.com/XTLS/Xray-core/releases/latest/download/Xray-linux-64.zip \
    && unzip /tmp/xray.zip -d /tmp/xray \
    && install -m755 /tmp/xray/xray /usr/local/bin/xray \
    && install -m644 /tmp/xray/geoip.dat /usr/local/share/xray/geoip.dat \
    && install -m644 /tmp/xray/geosite.dat /usr/local/share/xray/geosite.dat \
    && rm -rf /var/lib/apt/lists/* /tmp/xray /tmp/xray.zip
COPY setup-client /usr/local/bin/setup-client
RUN chmod +x /usr/local/bin/setup-client
COPY entry.sh /entry.sh
COPY registry.py /registry.py
RUN chmod +x /entry.sh
ENTRYPOINT ["/entry.sh"]
EOF
  cat >"$ctx/registry.py" <<'EOF'
#!/usr/bin/env python3
import json, base64, os, sys, time
from http.server import BaseHTTPRequestHandler, HTTPServer
from pathlib import Path

DATA = Path(sys.argv[1]) if len(sys.argv)>1 else Path('/etc/vless-mesh/peers.json')
TOKEN_FILE = Path('/etc/vless-mesh/token')
HOSTS_DIR = Path('/etc/tinc/mesh/hosts')

def load_token():
    try:
        return TOKEN_FILE.read_text().strip()
    except Exception:
        return ''

def load_peers():
    if DATA.exists():
        return json.loads(DATA.read_text())
    return {"uuid": None, "peers": []}

def save_peers(data):
    tmp = DATA.with_suffix('.tmp')
    tmp.write_text(json.dumps(data, indent=2))
    tmp.replace(DATA)

class Handler(BaseHTTPRequestHandler):
    def _auth(self):
        token = self.headers.get('X-Mesh-Token','')
        return token == load_token()
    def _json(self, code, obj):
        body = json.dumps(obj).encode()
        self.send_response(code)
        self.send_header('Content-Type','application/json')
        self.send_header('Content-Length', str(len(body)))
        self.end_headers(); self.wfile.write(body)
    def do_GET(self):
        if self.path != '/peers':
            self.send_response(404); self.end_headers(); return
        if not self._auth():
            self.send_response(401); self.end_headers(); return
        data = load_peers()
        self._json(200, data)
    def do_POST(self):
        if self.path != '/register':
            self.send_response(404); self.end_headers(); return
        if not self._auth():
            self.send_response(401); self.end_headers(); return
        length = int(self.headers.get('Content-Length','0'))
        try:
            payload = json.loads(self.rfile.read(length))
        except Exception:
            self._json(400,{"error":"bad json"}); return
        required = ["name","mesh_ip","pub_addr","vless_port","reality_pub","short_id","sni","tinc_port","fw_base","uuid","host_b64","accept"]
        if any(k not in payload for k in required):
            self._json(400,{"error":"missing fields"}); return
        data = load_peers()
        if data.get('uuid') and data['uuid'] != payload['uuid']:
            self._json(400,{"error":"uuid mismatch"}); return
        if not data.get('uuid'):
            data['uuid'] = payload['uuid']
        payload['updated'] = int(time.time())
        try:
            raw = base64.b64decode(payload['host_b64'])
            HOSTS_DIR.mkdir(parents=True, exist_ok=True)
            (HOSTS_DIR / payload['name']).write_bytes(raw)
        except Exception:
            self._json(400,{"error":"bad host_b64"}); return
        peers = [p for p in data['peers'] if p.get('name') != payload['name']]
        peers.append({k:payload[k] for k in payload})
        data['peers'] = peers
        save_peers(data)
        self._json(200, data)

def run():
    port = int(os.environ.get('REGISTRY_PORT','9000'))
    httpd = HTTPServer(('0.0.0.0', port), Handler)
    httpd.serve_forever()

if __name__ == '__main__':
    run()
EOF
}

build_image() {
  ensure_docker
  write_docker_context
  docker build -t "$IMAGE_TAG" /etc/vless-mesh/docker-node
  if [[ -n "$IMAGE_REGISTRY" ]]; then
    docker push "$IMAGE_TAG"
  fi
}

write_compose() {
  local file="/etc/vless-mesh/docker-compose.mesh.yml"
  cat >"$file" <<EOF
version: "3.9"
services:
  mesh:
    image: $IMAGE_TAG
    network_mode: host
    cap_add:
      - NET_ADMIN
    devices:
      - /dev/net/tun:/dev/net/tun
    volumes:
      - /etc/tinc/mesh:/etc/tinc/mesh
      - /usr/local/etc/xray:/usr/local/etc/xray
      - /etc/vless-mesh:/etc/vless-mesh
    environment:
      - MODE=server
      - ENABLE_REGISTRY=1
      - ENABLE_IPERF=1
      - REGISTRY_PORT=$REG_PORT
    restart: unless-stopped
EOF
  echo "$file"
}

write_k8s_manifest() {
  local file="/etc/vless-mesh/mesh-server.yaml"
  cat >"$file" <<EOF
apiVersion: apps/v1
kind: Deployment
metadata:
  name: mesh-server
  namespace: default
spec:
  replicas: 1
  selector:
    matchLabels:
      app: mesh-server
  template:
    metadata:
      labels:
        app: mesh-server
    spec:
      nodeSelector:
        kubernetes.io/hostname: $HOST_NODE
      hostNetwork: true
      dnsPolicy: ClusterFirstWithHostNet
